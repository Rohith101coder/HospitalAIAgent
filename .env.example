# Database – TiDB Cloud
DB_HOST=gateway01.ap-southeast-1.prod.alicloud.tidbcloud.com
DB_PORT=4000
DB_USER=24PCcrjs8ZsEomE.root
DB_PASSWORD=
DB_NAME=medibook
# Path to custom CA certificate file (if omitted, system/certifi CA bundle is used for TiDB Cloud TLS verification)
DB_SSL_CA=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Brevo (Sendinblue)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@medidesk.hospital
BREVO_SENDER_NAME=MediDesk Hospital

# Admin Initial Credentials
ADMIN_EMAIL=admin@medidesk.hospital
ADMIN_PASSWORD=AdminPassword123!

# JWT Security
JWT_SECRET=supersecretjwtkey_change_in_production_min_32_chars!
JWT_EXPIRE_MINUTES=60

# Application
APP_NAME=MediDesk Agent
APP_ENV=development
FRONTEND_URL=http://localhost:5173
HOSPITAL_TIMEZONE=Asia/Kolkata
EMERGENCY_NUMBER=108
FRONT_DESK_EMAIL=frontdesk@medidesk.hospital

# OTP Verification
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# AI Configuration
OPENROUTER_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=5

# Sessions
CHAT_SESSION_EXPIRY_HOURS=24

# Scheduler
ENABLE_SCHEDULER=true

